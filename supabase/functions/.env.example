# Kopieren nach supabase/functions/.env (git-ignoriert) und Werte eintragen.
# In Produktion: als Supabase-Secrets setzen (Dashboard → Edge Functions → Secrets).

# Gemeinsamer Werkstatt-Code (Frontend fragt ihn einmal ab)
WERKSTATT_CODE=

# Shop-Zugangsdaten (nur serverseitig!)
WEICHBERGER_USER=
WEICHBERGER_PASSWORD=
GOEGGEL_USER=
GOEGGEL_PASSWORD=

# Erlaubte Frontend-Adressen (CORS), kommagetrennt
ALLOWED_ORIGINS=http://localhost:5173

# Preisberechnung (Standardwerte, nur zum Ändern setzen)
# PRICE_MARKUP_EUR=39
# VAT_PERCENT=20
# PRICE_ROUNDING_EUR=0.10

# Versand: "freeFrom=<Stück ab dem frei>;perUnit=<€ je Reifen darunter>"
# SHIPPING_GOEGGEL=freeFrom=2;perUnit=6.50
# Weichberger: Werte mit dem Onkel klären; leer = "Versand nicht hinterlegt"
SHIPPING_WEICHBERGER=

# MAX_OFFERS_PER_SHOP=20
# SEARCH_TIMEOUT_MS=60000
